PORT=3000
JWT_SECRET=change-me-in-production
JWT_TTL=12h

DB_PATH=./data/helpdesk.db
UPLOAD_DIR=./uploads

# AI auto-reply (opsional). Kosongkan AI_API_KEY untuk memakai fallback knowledge base.
AI_AUTO_REPLY=true
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000

# Interval pemeriksaan SLA (ms)
SLA_TICK_MS=30000
